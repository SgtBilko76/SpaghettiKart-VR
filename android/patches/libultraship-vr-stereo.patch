+void Interpreter::ApplyStereoPanel(float& x, float& y, float& z, float& w) const {
+    const auto& m = mStereo.panelMatrix;
+    const float newX = m[0][0] * x + m[0][1] * y + m[0][2] * w;
+    const float newY = m[1][0] * x + m[1][1] * y + m[1][2] * w;
+    const float newW = m[2][0] * x + m[2][1] * y + m[2][2] * w;
+    // Keep the original normalized depth
+    z = w != 0.0f ? z / w * newW : z;
+    x = newX;
+    y = newY;
+    w = newW;
+}
