+    // Stereo (VR) rendering support. When a projection matrix is loaded, the hook may rewrite it in
+    // place and classifies it. 2D geometry drawn with a Panel projection, and all rectangles, is then
+    // reprojected from its clip-space (x, y, w) through panelMatrix, which places it on a panel in 3D space.
+    enum class StereoProjection { Perspective, Panel, Fullscreen };
+    struct StereoParams {
+        bool enabled = false;
+        std::function<StereoProjection(float matrix[4][4])> projectionHook;
+        // Rows produce clip x, y and w; columns take clip x, y and w
+        float panelMatrix[3][3] = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } };
+    } mStereo;
+    StereoProjection mStereoProjection = StereoProjection::Perspective;
+    void ApplyStereoPanel(float& x, float& y, float& z, float& w) const;
 };
 
